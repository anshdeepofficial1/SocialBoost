APP_NAME=SocialBoost AI
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
# SQLite is for local development. Use durable PostgreSQL in production.
# Hosted postgres:// and postgresql:// URLs are normalized to psycopg v3.
DATABASE_URL=sqlite:///./backend/socialboost.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEMO_MODE=true
MODEL_DIR=./ml/artifacts
FRONTEND_URL=http://localhost:3000
# For production, set DATABASE_URL to your hosted PostgreSQL connection URL.
# Keep the production SECRET_KEY stable across deploys; it also encrypts OAuth tokens.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Live publishing is not implemented. Non-sandbox scheduled posts are recorded
# as failed with an explanation rather than being reported as published.
LIVE_PUBLISHING_ENABLED=false

# Minimum historical rows before a workspace model will train.
MIN_TRAINING_ROWS=10

# Optional OAuth credentials. Without these, direct connections stay disabled.
# Keep provider secrets in the backend environment only; never in Vercel frontend
# variables or committed source. See README.md for the Google Cloud setup steps.
#   Instagram callback: https://socialboost-yzx2.onrender.com/social/oauth/instagram/callback
#   YouTube callback:   https://socialboost-yzx2.onrender.com/social/oauth/youtube/callback
# IG_CLIENT_ID=
# IG_CLIENT_SECRET=
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# Explicitly pin the backend's public base URL so reverse-proxy headers cannot
# cause redirect_uri_mismatch. Do not include a callback path or trailing slash.
# OAUTH_REDIRECT_BASE=https://socialboost-yzx2.onrender.com
